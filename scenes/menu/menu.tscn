[node name="LblAprenderText" type="Label" parent="Modais/ModalAprender/VBoxAprender" unique_id=1588649370]
layout_mode = 2
size_flags_vertical = 3
text = "• Tokens: Palavras-chave, identificadores, números e operadores da linguagem.
• Scanner: Analisador léxico que lê o código-fonte e agrupa caracteres em tokens.
